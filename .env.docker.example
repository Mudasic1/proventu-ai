# Copy this file to .env before running docker compose.

# Shared Neon pooled database connection used by both services.
DATABASE_URI=postgresql://user:password@host-pooler.region.aws.neon.tech/database?sslmode=require

# Next.js and Better Auth runtime settings.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Optional password reset email webhook transport. Leave blank to disable.
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_SECRET=

# Internal shared secret used by the frontend to call backend-ai.
AI_BACKEND_SHARED_SECRET=replace-with-at-least-32-random-characters

# Google Gemini settings for backend-ai.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
