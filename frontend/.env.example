# Runtime database connection. Use the pooled Neon connection string for the app.
DATABASE_URI=postgresql://user:password@host-pooler.region.aws.neon.tech/database?sslmode=require

# Optional direct Neon connection for Drizzle migrations.
DATABASE_DIRECT_URI=postgresql://user:password@host.region.aws.neon.tech/database?sslmode=require

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Optional webhook transport for password reset delivery. Configure both values together.
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_SECRET=

# Optional Google CRM integration. Configure both values together.
# Local OAuth redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Internal server-to-server AI service connection. Keep the shared secret server-side.
AI_BACKEND_URL=http://localhost:8000
AI_BACKEND_SHARED_SECRET=replace-with-at-least-32-random-characters
