# Runtime database URL. Use the pooled Neon URL for serverless application traffic.
DATABASE_URI=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/database?sslmode=require

# Migration URL. Use the direct Neon URL without "-pooler" in the hostname.
DATABASE_DIRECT_URI=postgresql://user:password@ep-example.region.aws.neon.tech/database?sslmode=require

# Generate with: npx auth@latest secret
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000

# Optional production integration. In development, reset links are printed to the server console.
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_SECRET=
